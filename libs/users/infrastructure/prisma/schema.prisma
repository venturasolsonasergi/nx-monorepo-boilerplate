generator client {
  provider = "prisma-client-js"
  output   = "./generated/client"
}

datasource db {
  provider = "postgresql"
}

model UserProfile {
  id           Int    @id(map: "user_profiles_pkey") @default(autoincrement())
  auth_user_id String @unique(map: "user_profiles_auth_user_id_key")
  name         String
  surname      String
  address      String
  phone        String

  @@map("user_profiles")
}

model UserSettings {
  id           Int    @id(map: "user_settings_pkey") @default(autoincrement())
  auth_user_id String @unique(map: "user_settings_auth_user_id_key")
  language     String

  @@map("user_settings")
}
