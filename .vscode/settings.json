{
  "chat.tools.terminal.autoApprove": {
    "pnpm": true
  },
  "i18n-ally.localesPaths": [
    "apps/web/src/shared/i18n/common",
    "apps/web/src/features/auth/i18n",
    "apps/web/src/features/landing/i18n",
    "apps/web/src/features/dashboard/i18n",
    "apps/web/src/features/settings/i18n"
  ],
  "i18n-ally.pathMatcher": "{locale}.json",
  "i18n-ally.keystyle": "nested",
  "i18n-ally.enabledParsers": ["json"],
  "i18n-ally.sourceLanguage": "es",
  "i18n-ally.displayLanguage": "es",
  "i18n-ally.translate.engines": ["google"]
}
