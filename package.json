{
  "name": "nestjs",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "format": "prettier --write \"apps/**/*.{ts,tsx}\" \"libs/**/*.ts\"",
    "lint": "eslint \"{apps,libs,scripts}/**/*.{ts,tsx}\"",
    "validate:openapi": "node scripts/validate-openapi.mjs",
    "validate:architecture": "tsx ./scripts/cli.ts validate:architecture",
    "validate:domain": "tsx ./scripts/cli.ts validate:domain",
    "check:domain-invariants": "tsx ./scripts/cli.ts check:domain-invariants",
    "check:dependencies": "tsx ./scripts/cli.ts check:dependencies",
    "pretest:contract": "pnpm prisma:generate",
    "test:contract": "tsx ./scripts/cli.ts test:contract",
    "preverify": "pnpm prisma:generate",
    "verify": "tsx ./scripts/cli.ts verify",
    "precode_review": "pnpm prisma:generate",
    "code_review": "tsx ./scripts/cli.ts code_review",
    "archive:architecture": "tsx ./scripts/cli.ts archive:architecture",
    "preapi:build": "pnpm prisma:generate",
    "api:build": "nest build && tsc-alias -p tsconfig.build.json && node scripts/copy-prisma-clients.mjs",
    "preapi:start": "pnpm prisma:generate",
    "api:start": "tsx apps/api/src/main.ts",
    "preapi:start:dev": "pnpm prisma:generate",
    "api:start:dev": "tsx watch apps/api/src/main.ts",
    "preapi:start:debug": "pnpm prisma:generate",
    "api:start:debug": "tsx watch --inspect apps/api/src/main.ts",
    "api:start:prod": "node -r tsconfig-paths/register dist/apps/api/src/main",
    "preapi:test": "pnpm prisma:generate",
    "api:test": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js",
    "preapi:test:watch": "pnpm prisma:generate",
    "api:test:watch": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --watch",
    "preapi:test:cov": "pnpm prisma:generate",
    "api:test:cov": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --coverage",
    "preapi:test:debug": "pnpm prisma:generate",
    "api:test:debug": "node --inspect-brk --experimental-vm-modules ./node_modules/jest/bin/jest.js --runInBand",
    "preapi:test:e2e": "pnpm prisma:generate",
    "api:test:e2e": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --config ./apps/api-e2e/test/jest-e2e.json",
    "prisma:generate": "tsx ./scripts/cli.ts prisma:generate",
    "prisma:migrate": "tsx ./scripts/cli.ts prisma:migrate",
    "web:dev": "vite --config apps/web/vite.config.ts",
    "web:build": "vite build --config apps/web/vite.config.ts",
    "web:preview": "vite preview --config apps/web/vite.config.ts",
    "web:test": "vitest --config apps/web/vite.config.ts",
    "web:e2e": "playwright test --config apps/web-e2e/playwright.config.ts"
  },
  "dependencies": {
    "@nestjs/common": "~12.1.2",
    "@nestjs/core": "~12.1.2",
    "@nestjs/platform-express": "~12.1.2",
    "@prisma/adapter-pg": "~7.10.0",
    "@prisma/client": "~7.10.0",
    "@prisma/client-runtime-utils": "~7.10.0",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-slot": "~1.3.3",
    "@tanstack/react-query": "~5.104.0",
    "@tanstack/react-router": "~1.170.41",
    "better-auth": "1.7.7",
    "class-variance-authority": "~0.7.1",
    "clsx": "~2.1.1",
    "lucide-react": "~1.49.0",
    "nestjs-pino": "^5.3.1",
    "nodemailer": "7.0.9",
    "pino": "^10.4.0",
    "react": "~19.3.0",
    "react-dom": "~19.3.0",
    "reflect-metadata": "~0.2.2",
    "rxjs": "~7.8.2",
    "tailwind-merge": "~3.7.0",
    "zod": "~4.6.5"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "~13.1.0",
    "@eslint/eslintrc": "~3.3.7",
    "@eslint/js": "~10.0.1",
    "@nestjs/cli": "~12.0.8",
    "@nestjs/schematics": "~12.0.6",
    "@nestjs/testing": "~12.1.2",
    "@nx/eslint": "~23.2.1",
    "@nx/eslint-plugin": "~23.2.1",
    "@nx/jest": "~23.2.1",
    "@nx/js": "~23.2.1",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "~4.3.3",
    "@tanstack/react-query-devtools": "~5.104.0",
    "@tanstack/router-devtools": "~1.167.2",
    "@testing-library/jest-dom": "~7.0.1",
    "@testing-library/react": "~16.3.3",
    "@types/express": "~5.0.6",
    "@types/jest": "~30.0.0",
    "@types/node": "~26.6.3",
    "@types/nodemailer": "7.0.3",
    "@types/pg": "~8.23.1",
    "@types/react": "~19.3.0",
    "@types/react-dom": "~19.3.0",
    "@types/supertest": "~7.2.1",
    "@vitejs/plugin-react": "~6.1.1",
    "autoprefixer": "~10.6.1",
    "dotenv": "~18.0.5",
    "eslint": "~10.11.0",
    "eslint-config-prettier": "~10.1.8",
    "eslint-plugin-prettier": "~5.5.6",
    "globals": "~17.12.0",
    "jest": "~30.5.2",
    "jsdom": "~30.1.1",
    "nx": "~23.2.1",
    "pg": "~8.23.1",
    "pino-pretty": "^13.2.0",
    "postcss": "~8.5.28",
    "prettier": "~3.9.9",
    "prisma": "~7.10.0",
    "source-map-support": "~0.5.21",
    "supertest": "~7.3.0",
    "tailwindcss": "~4.3.3",
    "tailwindcss-animate": "~1.0.7",
    "ts-jest": "~29.4.14",
    "ts-loader": "~9.6.2",
    "ts-node": "~10.9.2",
    "tsc-alias": "~1.9.7",
    "tsconfig-paths": "~4.2.0",
    "tsx": "~4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "~8.71.0",
    "vite": "~8.3.1",
    "vitest": "~5.0.3"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "roots": [
      "<rootDir>/apps",
      "<rootDir>/libs"
    ],
    "moduleNameMapper": {
      "^@app/api/(.*)$": "<rootDir>/apps/api/src/$1",
      "^@app/users/(.*)$": "<rootDir>/libs/users/$1",
      "^@app/orders/(.*)$": "<rootDir>/libs/orders/$1",
      "^@app/auth/(.*)$": "<rootDir>/libs/auth/$1",
      "^@app/shared/domain$": "<rootDir>/libs/shared/domain",
      "^@app/shared/domain/(.*)$": "<rootDir>/libs/shared/domain/$1",
      "^@app/shared/validation$": "<rootDir>/libs/shared/validation",
      "^@app/shared/validation/(.*)$": "<rootDir>/libs/shared/validation/$1",
      "^@app/shared/api-contracts$": "<rootDir>/libs/shared/api-contracts",
      "^@app/shared/api-contracts/(.*)$": "<rootDir>/libs/shared/api-contracts/$1"
    },
    "testRegex": ".*\\.spec\\.ts$",
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/apps/api-e2e/",
      "/apps/web-e2e/"
    ],
    "extensionsToTreatAsEsm": [
      ".ts"
    ],
    "transform": {
      "^.+\\.(t|j)s$": [
        "ts-jest",
        {
          "useESM": true,
          "tsconfig": {
            "module": "ESNext",
            "moduleResolution": "Bundler"
          }
        }
      ]
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "coverage",
    "testEnvironment": "node"
  }
}
