{
  "name": "nestjs",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build:scripts": "tsc -p tsconfig.scripts.json",
    "format": "prettier --write \"apps/**/*.{ts,tsx}\" \"libs/**/*.ts\"",
    "lint": "eslint \"{apps,libs,scripts}/**/*.{ts,tsx}\"",
    "validate:openapi": "node scripts/validate-openapi.mjs",
    "validate:architecture": "tsx ./scripts/cli.ts validate:architecture",
    "validate:domain": "tsx ./scripts/cli.ts validate:domain",
    "check:domain-invariants": "tsx ./scripts/cli.ts check:domain-invariants",
    "check:dependencies": "tsx ./scripts/cli.ts check:dependencies",
    "pretest:contract": "pnpm prisma:generate",
    "test:contract": "tsx ./scripts/cli.ts test:contract",
    "report:microservice-health": "tsx ./scripts/cli.ts report:microservice-health",
    "preverify": "pnpm prisma:generate",
    "verify": "tsx ./scripts/cli.ts verify",
    "precode_review": "pnpm prisma:generate",
    "code_review": "tsx ./scripts/cli.ts code_review",
    "archive:architecture": "tsx ./scripts/cli.ts archive:architecture",
    "publish": "tsx ./scripts/cli.ts publish",
    "preapi:build": "pnpm prisma:generate",
    "api:build": "nest build && tsc-alias -p tsconfig.build.json && node scripts/copy-prisma-clients.mjs",
    "preapi:start": "pnpm prisma:generate",
    "api:start": "tsx apps/api/src/main.ts",
    "preapi:start:dev": "pnpm prisma:generate",
    "api:start:dev": "tsx watch apps/api/src/main.ts",
    "preapi:start:debug": "pnpm prisma:generate",
    "api:start:debug": "tsx watch --inspect apps/api/src/main.ts",
    "api:start:prod": "node -r tsconfig-paths/register dist/apps/api/src/main",
    "preapi:test": "pnpm prisma:generate",
    "api:test": "jest",
    "preapi:test:watch": "pnpm prisma:generate",
    "api:test:watch": "jest --watch",
    "preapi:test:cov": "pnpm prisma:generate",
    "api:test:cov": "jest --coverage",
    "preapi:test:debug": "pnpm prisma:generate",
    "api:test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "preapi:test:e2e": "pnpm prisma:generate",
    "api:test:e2e": "jest --config ./apps/api-e2e/test/jest-e2e.json",
    "prisma:generate": "pnpm prisma:generate:users && pnpm prisma:generate:orders",
    "prisma:generate:users": "prisma generate --schema libs/users/infrastructure/prisma/schema.prisma",
    "prisma:generate:orders": "prisma generate --schema libs/orders/infrastructure/prisma/schema.prisma",
    "prisma:migrate:users": "prisma migrate dev --schema libs/users/infrastructure/prisma/schema.prisma",
    "prisma:migrate:orders": "prisma migrate dev --schema libs/orders/infrastructure/prisma/schema.prisma",
    "web:dev": "vite --config apps/web/vite.config.ts",
    "web:build": "vite build --config apps/web/vite.config.ts",
    "web:preview": "vite preview --config apps/web/vite.config.ts",
    "web:test": "vitest --config apps/web/vite.config.ts"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.1",
    "@nestjs/core": "^11.0.1",
    "@nestjs/platform-express": "^11.0.1",
    "@prisma/client": "^6.13.0",
    "@radix-ui/react-slot": "^1.3.3",
    "@tanstack/react-query": "^5.103.1",
    "@tanstack/react-router": "^1.170.38",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.47.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "tailwind-merge": "^3.7.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "^13.1.0",
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@nx/eslint": "^23.2.1",
    "@nx/eslint-plugin": "^23.2.1",
    "@nx/jest": "^23.2.1",
    "@nx/js": "^23.2.1",
    "@nx/nest": "^23.2.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query-devtools": "^5.103.1",
    "@tanstack/router-devtools": "^1.167.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/supertest": "^7.0.0",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.6.1",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^17.0.0",
    "jest": "^30.0.0",
    "jsdom": "^30.1.0",
    "nx": "^23.2.1",
    "postcss": "^8.5.28",
    "prettier": "^3.4.2",
    "prisma": "^6.13.0",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "tailwindcss": "^4.3.3",
    "tailwindcss-animate": "^1.0.7",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsc-alias": "^1.9.5",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.19.4",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "roots": [
      "<rootDir>/apps",
      "<rootDir>/libs"
    ],
    "moduleNameMapper": {
      "^@app/api/(.*)$": "<rootDir>/apps/api/src/$1",
      "^@app/users/(.*)$": "<rootDir>/libs/users/$1",
      "^@app/orders/(.*)$": "<rootDir>/libs/orders/$1",
      "^@app/shared/domain$": "<rootDir>/libs/shared/domain",
      "^@app/shared/domain/(.*)$": "<rootDir>/libs/shared/domain/$1",
      "^@app/shared/validation$": "<rootDir>/libs/shared/validation",
      "^@app/shared/validation/(.*)$": "<rootDir>/libs/shared/validation/$1",
      "^@app/shared/api-contracts$": "<rootDir>/libs/shared/api-contracts",
      "^@app/shared/api-contracts/(.*)$": "<rootDir>/libs/shared/api-contracts/$1"
    },
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "coverage",
    "testEnvironment": "node"
  }
}
