{
  "deliveryFlow": ["spec", "domain", "application", "infrastructure"],
  "dependencyDirection": ["infrastructure", "application", "domain"],
  "forbiddenImports": {
    "domain": ["@nestjs/*", "@prisma/client", "zod"],
    "application": ["@prisma/client"]
  },
  "allowedSharedUsage": {
    "domain": ["libs/shared/domain"],
    "application": ["libs/shared/domain", "libs/shared/validation"],
    "infrastructure": ["libs/shared/domain", "libs/shared/validation"]
  },
  "autonomy": {
    "forbidCrossMicroserviceDomainImports": true,
    "forbidDirectCrossMicroserviceImports": true,
    "crossMicroserviceIntegration": {
      "allowed": ["publicApplicationApi", "domainEvents"],
      "forbidden": ["directModuleImport", "directDomainImport"],
      "description": "Microservices cannot import another microservice directly by path such as src/users or src/orders. Cross-microservice communication must happen only through public application APIs or published domain events."
    }
  }
}
