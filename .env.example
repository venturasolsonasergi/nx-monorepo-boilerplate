POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=postgres
POSTGRES_PORT=5432
API_PORT=3000
USERS_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/users_db?schema=public
ORDERS_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/orders_db?schema=public
AUTH_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/auth_db?schema=public

# Disposable databases used only by the e2e suite (apps/api-e2e). They are
# created and migrated automatically and must stay empty outside of a test run.
USERS_TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/users_test_db?schema=public
AUTH_TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/auth_test_db?schema=public

# Auth service configuration. AUTH_SECRET must be a strong, unique secret in
# every real environment; leave it empty in source control.
AUTH_SECRET=
AUTH_BASE_URL=http://localhost:3000
AUTH_TRUSTED_ORIGINS=http://localhost:4200

# Comma-separated IP addresses / CIDR ranges of reverse proxies you control.
# When the direct peer is trusted, the leftmost untrusted hop in
# X-Forwarded-For is used as the client source IP for auth rate limits and
# session attribution; forwarded headers from direct callers are otherwise
# ignored so they cannot be spoofed.
AUTH_TRUSTED_PROXIES=

# Public support contact offered on the signup/pending screens so users who do
# not receive the activation message can ask for help. Required in production;
# leave empty in development to hide the contact. Only this address is exposed
# through GET /auth/public-config; never SMTP credentials or auth secrets.
AUTH_SUPPORT_EMAIL=

# Verification resend and rate-limit configuration (seconds). Initial signup and
# resend share these limits.
#   AUTH_VERIFICATION_RESEND_WINDOW_SECONDS  per-address resend window
#   AUTH_VERIFICATION_SOURCE_WINDOW_SECONDS  per-source window
#   AUTH_VERIFICATION_SOURCE_MAX             max attempts per source window
#   AUTH_VERIFICATION_THROTTLE_RETENTION_SECONDS  throttle retention, which must
#                                                be at least the longest window
AUTH_VERIFICATION_RESEND_WINDOW_SECONDS=60
AUTH_VERIFICATION_SOURCE_WINDOW_SECONDS=3600
AUTH_VERIFICATION_SOURCE_MAX=20
AUTH_VERIFICATION_THROTTLE_RETENTION_SECONDS=86400

# A pending registration expires exactly 48 hours after initiation. This is part
# of the contract, not a configurable sliding window: repeating signup or resend
# never extends the deadline, and an expired registration requires a new signup.

# Mail transport used for verification and password-reset messages. Production
# requires a syntactically valid configuration (host and MAIL_FROM); temporary
# unreachability does not prevent startup but is reported as a failed send.
#
# Local development uses Mailpit (see docker-compose.yml). Inside Compose leave
# SMTP_HOST empty so the API sends to the bundled `mailpit:1025`; the Mailpit UI
# is exposed at http://localhost:8025. When running the API on the host, set
# SMTP_HOST=localhost and SMTP_PORT=1025. Set host/port/credentials to an
# external SMTP server to override Mailpit entirely.
SMTP_HOST=
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=no-reply@example.com
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

# OAuth providers. Only configured providers are enabled.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Dev-only API documentation served by the API host (GET /docs and
# GET /docs/openapi.json). Enabled outside production and disabled in
# production by default; set to true or false to override in any environment.
# The merged document is internal information, so keep it disabled in
# production until an authenticated audience is defined.
API_DOCS_ENABLED=

# ===========================================================================
# PRODUCTION ENVIRONMENT — reference values, NOT a copy-paste section.
#
# Do NOT append these lines to a local development .env file: dotenv applies
# the LAST value it sees for a key, so the production URLs below would
# silently override the development ones above. These are the variables to
# configure on the production platform (one per line, mirrored line by line
# in docs/deployment.md). See docs/deployment.md for the full runbook.
# ===========================================================================
# Managed PostgreSQL instance, database-per-service. The three databases are
# created once during bootstrap (docs/deployment.md); every connection string
# keeps `?schema=public&sslmode=require`.
AUTH_DATABASE_URL=postgresql://<user>:<password>@<managed-postgres-host>:5432/auth_db?schema=public&sslmode=require
USERS_DATABASE_URL=postgresql://<user>:<password>@<managed-postgres-host>:5432/users_db?schema=public&sslmode=require
ORDERS_DATABASE_URL=postgresql://<user>:<password>@<managed-postgres-host>:5432/orders_db?schema=public&sslmode=require

# Auth service configuration.
AUTH_SECRET=<strong-unique-secret-at-least-32-chars>
AUTH_BASE_URL=https://<api-app-origin>
AUTH_WEB_URL=https://<web-app-origin>
AUTH_TRUSTED_ORIGINS=https://<web-app-origin>

# Required by the auth service in production; startup fails without them.
AUTH_SUPPORT_EMAIL=<support@example.com>
SMTP_HOST=<outbound-smtp-host>
MAIL_FROM=<no-reply@your-domain>

# Release identification injected by the deployment platform.
APP_VERSION=0.0.1
GIT_SHA=<commit-sha>

# Optional overrides. LOG_LEVEL defaults to warn in production; use info for
# the first-deploy smoke test so the listening log is visible. PORT is the
# internal listen port the platform maps to.
LOG_LEVEL=info
PORT=3000
